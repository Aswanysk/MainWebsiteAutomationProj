<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Demo Web Shop Cross Browser Suite"
       parallel="test"
       thread-count="3">

    <listeners>
        <listener class-name="utilities.ExtentTestListener"/>
    </listeners>

    <!-- Chrome -->
    <test name="Chrome Tests">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="ecommerce.LoginTest"/>
            <class name="ecommerce.AddToCartTest"/>
            <class name="ecommerce.ProductSearchTest"/>
            <class name="ecommerce.AlertTest"/>
            <class name="ecommerce.LogoutTest"/>
            <class name="ecommerce.ScreenshotTest"/>
        </classes>

    </test>

</suite>